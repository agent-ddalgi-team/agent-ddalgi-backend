# 실행 모드: mock = AI 호출 없음(기본) / llm = 실제 호출
AGENT_MODE=mock
# llm 모드에서만 필요. 절대 커밋하지 않는다.
OPENAI_API_KEY=
# 임시 파일·DB 위치 (gitignore됨). DB 파일은 기본 <PRIVATE_RUNS_DIR>/app.sqlite3
PRIVATE_RUNS_DIR=private_runs
# DB_PATH=private_runs/app.sqlite3

# --- 아래는 선택. 비우면 app/config.py 기본값(plan.md 4절 D-01/D-02 제안값) ---
# SESSION_IDLE_MINUTES=120
# SESSION_MAX_HOURS=24
# MAX_FILE_BYTES=10485760
# MAX_FILES_PER_SESSION=10
# 프론트 origin 추가(쉼표 구분). 기본: http://localhost:5173, http://127.0.0.1:5173
# FRONTEND_ORIGINS=
# HTTPS 배포에서만 true
# OWNER_COOKIE_SECURE=false
# PDF 출력용 브라우저(BE-07). 비우면 Chrome → Edge 자동 탐색. 예: C:\Program Files\Google\Chrome\Application\chrome.exe
# EXPORT_BROWSER_PATH=
# EXPORT_RENDER_TIMEOUT_S=90
# Export 만료(분, BE-08). 세션 만료와 같거나 그 이전으로 잘린다.
# EXPORT_TTL_MINUTES=120
# 세션 종료·만료 정리(BE-09). 배경 sweep 주기(초, 0=배경 스레드 없음), 폴더 삭제 재시도 상한, 처리 점유 유효시간(초)
# CLEANUP_SWEEP_INTERVAL_S=60
# CLEANUP_MAX_ATTEMPTS=10
# CLEANUP_CLAIM_TTL_S=600
# 시연 데이터 허용. 끄면 시연 세션 사용만 차단하며 명시적 삭제와 기존 만료 규칙은 유지.
# DEMO_MODE=false
