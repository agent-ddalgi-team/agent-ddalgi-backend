# 실행 모드: mock = AI 호출 없음(기본) / llm = 실제 호출
AGENT_MODE=mock
# 아래 6개 설정은 llm 모드에서 모두 필요하다. 실제 비밀값은 커밋하지 않는다.
# 아래 값은 plan.md D-04의 승인된 첫 시험값이다. 실제 호출 승인은 별도다.
# 기본 실행은 AGENT_MODE=mock을 유지한다. 실제 AI 시험은 승인한 범위에서만 별도로 실행한다.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
# 요청 대기 시간(초, 0보다 큰 유한한 수)
OPENAI_TIMEOUT_SECONDS=60
# SDK 통신 재시도 횟수(0 이상의 정수). 내용 오류에 대한 재생성은 하지 않는다.
OPENAI_MAX_RETRIES=0
# 응답 토큰 상한(양의 정수, 선택 모델의 허용 범위도 확인)
OPENAI_MAX_OUTPUT_TOKENS=8000
# 선택 자료 텍스트/초안용 사실 텍스트 합계의 상한(문자 수, 1~40000)
# 40000은 이전 검사 코드의 호환 상한이다. 운영 권장값·모델 토큰 한도와는 다르다.
OPENAI_MAX_INPUT_CHARS=10000
# 첫 시험 가드: 단일 프로세스에서 추출/초안 각 4회, 합계 8회, 예상 비용 $1.
# 요청마다 Standard 처리·중간 추론 강도를 사용한다. 한도 밖 설정은 호출 전 차단한다.
# 오류/사용량 미확인/수동 중단 뒤에는 재호출하지 않는다. 기록·중단은 agent.md 4.4절 참조.
# 기록은 메모리에만 남는다. 실제 시험은 reload·다중 worker 없이 진행하고 재시작으로 이어서 시험하지 않는다.
# 요청은 store=false로 보낸다. 외부 서비스의 로그·보관 정책은 실제 호출 승인 전에 별도 확인한다.
# 임시 파일·DB 위치 (gitignore됨). DB 파일은 기본 <PRIVATE_RUNS_DIR>/app.sqlite3
PRIVATE_RUNS_DIR=private_runs
# DB_PATH=private_runs/app.sqlite3

# --- 아래는 선택. 비우면 app/config.py 기본값(plan.md 4절 D-01/D-02 제안값) ---
# SESSION_IDLE_MINUTES=120
# SESSION_MAX_HOURS=24
# MAX_FILE_BYTES=10485760
# MAX_FILES_PER_SESSION=10
# 프론트 origin 추가(쉼표 구분). 기본: http://localhost:5173, http://127.0.0.1:5173
# FRONTEND_ORIGINS=
# HTTPS 배포에서만 true
# OWNER_COOKIE_SECURE=false
# PDF 출력용 브라우저(BE-07). 비우면 Chrome → Edge 자동 탐색. 예: C:\Program Files\Google\Chrome\Application\chrome.exe
# EXPORT_BROWSER_PATH=
# EXPORT_RENDER_TIMEOUT_S=90
# Export 만료(분, BE-08). 세션 만료와 같거나 그 이전으로 잘린다.
# EXPORT_TTL_MINUTES=120
# 세션 종료·만료 정리(BE-09). 배경 sweep 주기(초, 0=배경 스레드 없음), 폴더 삭제 재시도 상한, 처리 점유 유효시간(초)
# CLEANUP_SWEEP_INTERVAL_S=60
# CLEANUP_MAX_ATTEMPTS=10
# CLEANUP_CLAIM_TTL_S=600
# 시연 데이터 허용. 끄면 시연 세션 사용만 차단하며 명시적 삭제와 기존 만료 규칙은 유지.
# DEMO_MODE=false
