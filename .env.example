# 실행 모드: mock = AI 호출 없음(기본) / llm = 실제 호출
AGENT_MODE=mock
# 실제 비밀값은 .env에만 보관한다. 일반 서버는 횟수·누적 비용 한도를 두지 않는다.
# 기본 모드는 mock이다. run_llm.ps1로 실제 AI와 확대 기본값을 적용할 수 있다.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
OPENAI_EXECUTION_MODE=runtime
# runtime: develop의 일반 실행(횟수/예산 차단 없음). interactive: 예산 있는 반복 시연. trial: 기존 제한 평가.
# interactive: SDK 재시도 0, 요청별 최대 180초/입력40000/출력32000. 직접 서버를 실행할 때는 대응 OPENAI_TRIAL_* 값도 설정한다.
# scripts/run_llm.ps1은 같은 실행 옵션으로 OPENAI_TRIAL_*를 함께 설정한다. -CheckOnly로 무호출 설정 검사를 할 수 있다.
# 예: OPENAI_TRIAL_TIMEOUT_LIMIT_SECONDS=180, OPENAI_TRIAL_INPUT_CHAR_LIMIT=40000, OPENAI_TRIAL_OUTPUT_TOKEN_LIMIT=32000.
# interactive 예산은 서버 프로세스별(0 초과 100 이하 USD)이며 재시작 시 초기화된다. 미확인 사용량은 최대 예약 비용으로 누적한다.
OPENAI_RUN_BUDGET_USD=5
# 요청별 SDK 대기 시간(초, 최대 300). 재시도 시 전체 작업은 이보다 길어질 수 있다.
OPENAI_TIMEOUT_SECONDS=180
# 일시적 통신/공급자 오류의 SDK 재시도 0~2회. 별도로 브로슈어 미완결/분량 오류만 최대 1회 재작성한다.
OPENAI_MAX_RETRIES=2
# 응답 토큰 상한 1~64000. 공급자의 실제 모델 한도도 적용된다.
OPENAI_MAX_OUTPUT_TOKENS=64000
# 점검 원문 합계/초안 사실 합계/수정안 JSON 크기 1~200000자
OPENAI_MAX_INPUT_CHARS=200000
# 내용 검증 JSON 크기 1~400000자. 비워도 기본 400000자이며 조용히 자르지 않는다.
OPENAI_REVIEW_MAX_INPUT_CHARS=400000
# 기능 활성화. run_llm.ps1 -ContentReview -TextProposals로 켠다. 적용은 별도 사용자 동작이다.
OPENAI_ENABLE_CONTENT_REVIEW=false
OPENAI_ENABLE_TEXT_PROPOSALS=false
# 요청 횟수와 누적 추정 비용은 관측용이다. 8회/$1/기능별 2·4회 가드는 일반 서버에 적용되지 않는다.
# 과거 OPENAI_TRIAL_* 값은 명시적으로 실행하는 제한된 평가용이며 일반 서버에서는 사용하지 않는다.
# 한 요청의 실패는 다른 요청을 중단시키지 않는다. 사용량 미확인은 0원으로 표시하지 않는다.
# 요청은 store=false이며, 사용자 수동 중단·자료 접근·근거 검사·승인 규칙은 유지한다.
# 임시 파일·DB 위치 (gitignore됨). DB 파일은 기본 <PRIVATE_RUNS_DIR>/app.sqlite3
PRIVATE_RUNS_DIR=private_runs
# DB_PATH=private_runs/app.sqlite3

# --- 아래는 선택. 비우면 app/config.py 기본값(plan.md 4절 D-01/D-02 제안값) ---
# SESSION_IDLE_MINUTES=120
# SESSION_MAX_HOURS=24
# MAX_FILE_BYTES=10485760
# MAX_FILES_PER_SESSION=10
# 프론트 origin 추가(쉼표 구분). 기본: http://localhost:5173, http://127.0.0.1:5173
# FRONTEND_ORIGINS=
# HTTPS 배포에서만 true
# OWNER_COOKIE_SECURE=false
# PDF 출력용 브라우저(BE-07). 비우면 Chrome → Edge 자동 탐색. 예: C:\Program Files\Google\Chrome\Application\chrome.exe
# EXPORT_BROWSER_PATH=
# EXPORT_RENDER_TIMEOUT_S=90
# DOCX 실제 배치 검사(선택). LibreOffice 설치 후 실행 파일 절대 경로를 지정한다.
# 미지정/설치 누락이면 DOCX 승인 차단 유지. 생성한 DOCX 자체의 변환 PDF로 검사/미리보기한다.
# Windows 권장: C:\Program Files\LibreOffice\program\soffice.com
# EXPORT_LIBREOFFICE_PATH=
# Export 만료(분, BE-08). 세션 만료와 같거나 그 이전으로 잘린다.
# EXPORT_TTL_MINUTES=120
# 세션 종료·만료 정리(BE-09). 배경 sweep 주기(초, 0=배경 스레드 없음), 폴더 삭제 재시도 상한, 처리 점유 유효시간(초)
# CLEANUP_SWEEP_INTERVAL_S=60
# CLEANUP_MAX_ATTEMPTS=10
# CLEANUP_CLAIM_TTL_S=600
# 시연 데이터 허용. 끄면 시연 세션 사용만 차단하며 명시적 삭제와 기존 만료 규칙은 유지.
# DEMO_MODE=false
# 동일 회사로 명시적으로 확인한 이름만 등록. 실제 회사명 목록은 로컬 .env에만 보관.
COMPANY_NAME_ALIASES=[]
